# Set these in Vercel Production, not in GitHub or a committed .env file.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
SESSION_SECRET=
# Fine-grained repository token with Contents write. Keep server-side only; rotate before expiry.
GITHUB_TOKEN=
# Optional: numeric ID of mdnhbn/AWS-66-Delta-Shell-Upload-Project
GITHUB_REPOSITORY_ID=
